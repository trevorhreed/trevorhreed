{
  "name": "trevorhreed",
  "version": "1.0.0",
  "description": "A personal website",
  "engines": {
    "node": "20"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "npm run watch & npm run serve",
    "serve": "npx serve docs -l 3000",
    "build": "npx --yes @yesiree/htmlc@0.0.12 -m -c -o '**/*.{json,jpg,png,svg}' -s src -d trevorhreed.com",
    "watch": "npx @yesiree/htmlc@0.0.12 -s src -d trevorhreed.com -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevorhreed/trevorhreed.git"
  },
  "author": "Trevor Reed",
  "bugs": {
    "url": "https://github.com/trevorhreed/trevorhreed/issues"
  },
  "homepage": "https://github.com/trevorhreed/trevorhreed#readme"
}
